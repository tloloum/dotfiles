#!/usr/bin/env bash
# Réglages du pavé tactile, quel que soit le modèle (nom différent d'un PC à l'autre) :
# défilement naturel + vitesse de défilement, appliqués à chaque périphérique « Touchpad ».
xinput list --name-only | grep -i touchpad | while read -r dev; do
  xinput set-prop "$dev" "libinput Natural Scrolling Enabled" 1
  xinput set-prop "$dev" "libinput Scrolling Pixel Distance" 25 2>/dev/null  # absent sur certains pilotes
done
