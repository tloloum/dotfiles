# Notifications (dunst) — thème noir assorti à polybar / rofi / eww
# Couleurs : dunstrc.d/colors.conf, généré depuis ~/.config/theme/colors.json

[global]
    monitor = 0
    follow = mouse

    # en haut à droite, sous la barre polybar
    origin = top-right
    offset = 12x40
    width = 380
    height = 160
    notification_limit = 5
    gap_size = 8

    # barre de progression (notify-send -h int:value:42 …)
    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 340
    progress_bar_corner_radius = 3

    # cadre
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 14
    frame_width = 1
    corner_radius = 8
    separator_height = 0
    separator_color = frame
    transparency = 0

    # texte
    font = CaskaydiaCove Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = end
    word_wrap = yes
    ignore_newline = no
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    # icônes (même thème que le lanceur rofi)
    icon_position = left
    icon_theme = Papirus-Dark
    enable_recursive_icon_lookup = true
    min_icon_size = 32
    max_icon_size = 48

    # historique (ctrl+` par défaut dans dunst : dunstctl history-pop)
    sticky_history = yes
    history_length = 30

    # souris : gauche = fermer, milieu = action, droit = tout fermer
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

    browser = /usr/bin/xdg-open
    dmenu = rofi -dmenu -theme bar-menu -p "action"

[urgency_low]
    timeout = 10

[urgency_normal]
    timeout = 10

[urgency_critical]
    timeout = 10
