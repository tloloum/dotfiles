export GTK2_RC_FILES="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-2.0/gtkrc"
export LESSHISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/less/history"
export WGETRC="${XDG_CONFIG_HOME:-$HOME/.config}/wget/wgetrc"

vim() { # to read nvim config"
  VIMINIT='set runtimepath^=$HOME/.config/vim runtimepath+=$HOME/.config/vim/after | source $HOME/.config/vim/vimrc' command vim "$@"
}

# ssh-agent classique : le socket est mis en cache dans ~/.ssh/agent.env pour
# être réutilisé entre les shells. On évite gcr-ssh-agent (GNOME Keyring) dont
# la popup graphique de passphrase (gcr4-ssh-askpass) ne fonctionne pas sous
# i3 et fait tourner ssh-add à 100% CPU indéfiniment.
_ssh_agent_env="$HOME/.ssh/agent.env"
if [ -f "$_ssh_agent_env" ]; then
  source "$_ssh_agent_env" >/dev/null
fi
if ! kill -0 "${SSH_AGENT_PID:-}" 2>/dev/null; then
  (umask 077; ssh-agent -s >| "$_ssh_agent_env")
  source "$_ssh_agent_env" >/dev/null
  ssh-add "$HOME/.ssh/id_ed25519" 2>/dev/null
fi
unset _ssh_agent_env

## PARAVIEW && TTK
export LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/home/tof/dev/ttk-paraview/build/lib
export PV_PLUGIN_PATH=${PV_PLUGIN_PATH}:/home/tof/dev/ttk-paraview/build/lib/paraview-6.1/plugins
export PYTHONPATH=${PYTHONPATH}:/home/tof/dev/ttk-paraview/build/lib/python3/dist-packages
