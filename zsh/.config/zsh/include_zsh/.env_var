export GTK2_RC_FILES="${XDG_CONFIG_HOME:-$HOME/.config}/gtk-2.0/gtkrc"
export LESSHISTFILE="${XDG_CACHE_HOME:-$HOME/.cache}/less/history"
export WGETRC="${XDG_CONFIG_HOME:-$HOME/.config}/wget/wgetrc"

vim() { # to read nvim config"
  VIMINIT='set runtimepath^=$HOME/.config/vim runtimepath+=$HOME/.config/vim/after | source $HOME/.config/vim/vimrc' command vim "$@"
}

## PARAVIEW && TTK
# ${VAR:+$VAR:} n'ajoute le "VAR:" que si VAR est non vide, pour éviter un ":"
# parasite en tête (qui avait cassé le chemin d'installation du plugin TTK)
export LD_LIBRARY_PATH=${LD_LIBRARY_PATH:+$LD_LIBRARY_PATH:}/home/tof/dev/ttk-paraview/build/lib
export PV_PLUGIN_PATH=${PV_PLUGIN_PATH:+$PV_PLUGIN_PATH:}/home/tof/dev/ttk-paraview/build/lib/paraview-6.1/plugins
export PYTHONPATH=${PYTHONPATH:+$PYTHONPATH:}/home/tof/dev/ttk-paraview/build/lib/python3/dist-packages
