#!/usr/bin/env python3
"""Alt+Tab avec icônes (rofi), une entrée par application.

  - ordre : la plus récemment utilisée d'abord (historique de focus d'i3)
  - plusieurs fenêtres d'une même appli → une seule icône, qui bascule sur la
    fenêtre de cette appli utilisée le plus récemment
  - Alt+Tab ouvre déjà positionné sur l'appli précédente ; Tab / Shift+Tab (Alt
    enfoncé) pour se déplacer ; relâcher Alt (ou Entrée) pour basculer ; Échap annule

Relâcher Alt : rofi ignore le relâchement d'une touche dont il n'a pas vu l'appui
(Alt est enfoncé avant son lancement). Le script surveille donc lui-même la touche
Alt (python-xlib) et envoie Entrée à rofi dès qu'elle est relâchée.
"""
import configparser
import glob
import json
import os
import subprocess
import sys
import threading
import time

from Xlib import X, XK, display
from Xlib.ext import xtest

DESKTOP_DIRS = ["~/.local/share/applications", "/usr/share/applications",
                "/var/lib/flatpak/exports/share/applications",
                "~/.local/share/flatpak/exports/share/applications"]
ITEM_WIDTH = 104  # px par icône (doit suivre alttab.rasi)
ICONS_DIR = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "icons")
ICON_OVERRIDES = {  # classe (minuscules) → image, prioritaire sur le thème d'icônes
    "alacritty": os.path.join(ICONS_DIR, "terminal.svg"),  # même glyphe que dans polybar
}


def i3_tree():
    out = subprocess.run(["i3-msg", "-t", "get_tree"], capture_output=True, text=True).stdout
    return json.loads(out or "{}")


def windows_mru(node, in_workspace=False):
    """Fenêtres dans l'ordre de focus d'i3 (la plus récente d'abord)."""
    if node.get("type") == "workspace":
        if node.get("name", "").startswith("__"):  # scratchpad interne
            return []
        in_workspace = True
    if node.get("window") and in_workspace:
        return [node]
    children = {c["id"]: c for c in node.get("nodes", []) + node.get("floating_nodes", [])}
    ordered = [children[i] for i in node.get("focus", []) if i in children]
    ordered += [c for c in children.values() if c not in ordered]
    result = []
    for child in ordered:
        result += windows_mru(child, in_workspace)
    return result


def desktop_index():
    """classe X11 (minuscules) → (nom, icône) d'après les fichiers .desktop."""
    index = {}
    for d in DESKTOP_DIRS:
        for path in glob.glob(os.path.join(os.path.expanduser(d), "*.desktop")):
            cp = configparser.ConfigParser(interpolation=None, strict=False)
            try:
                cp.read(path, encoding="utf-8")
                entry = cp["Desktop Entry"]
            except (configparser.Error, KeyError, UnicodeDecodeError):
                continue
            info = (entry.get("Name", ""), entry.get("Icon", ""))
            stem = os.path.basename(path)[:-8].lower()
            index.setdefault(stem, info)
            if entry.get("StartupWMClass"):
                index.setdefault(entry["StartupWMClass"].lower(), info)
    return index


def rofi_window_exists(dpy):
    """Vrai quand la fenêtre de rofi est affichée (avant, Entrée irait à une autre appli)."""
    for win in dpy.screen().root.query_tree().children:
        try:
            cls = win.get_wm_class()
        except Exception:  # fenêtre disparue entre-temps
            continue
        if cls and cls[1] == "Rofi":
            return True
    return False


def accept_on_alt_release(proc):
    """Envoie Entrée à rofi quand Alt (gauche et droit) n'est plus enfoncé."""
    dpy = display.Display()
    alts = [dpy.keysym_to_keycode(XK.string_to_keysym(k)) for k in ("Alt_L", "Alt_R")]
    while proc.poll() is None and not rofi_window_exists(dpy):
        time.sleep(0.01)
    while proc.poll() is None:
        keymap = dpy.query_keymap()
        if not any(keymap[kc // 8] & (1 << (kc % 8)) for kc in alts if kc):
            ret = dpy.keysym_to_keycode(XK.string_to_keysym("Return"))
            xtest.fake_input(dpy, X.KeyPress, ret)
            xtest.fake_input(dpy, X.KeyRelease, ret)
            dpy.sync()
            return
        time.sleep(0.02)


def main():
    seen, apps = set(), []
    for win in windows_mru(i3_tree()):
        cls = (win.get("window_properties") or {}).get("class") or "?"
        if cls.lower() in seen:
            continue  # déjà listée : on garde sa fenêtre la plus récente
        seen.add(cls.lower())
        apps.append((cls, win["id"]))
    if not apps:
        return

    index = desktop_index()
    rows = []
    for cls, _ in apps:
        _, icon = index.get(cls.lower(), ("", ""))
        icon = os.path.normpath(ICON_OVERRIDES[cls.lower()]) if cls.lower() in ICON_OVERRIDES else icon
        label = cls[:1].upper() + cls[1:]  # nom court (« Firefox », pas « Firefox Web Browser »)
        rows.append(f"{label}\0icon\x1f{icon or cls.lower()}")

    width = len(apps) * ITEM_WIDTH + 40
    proc = subprocess.Popen(
        ["rofi", "-dmenu", "-i", "-no-custom", "-format", "i", "-theme", "alttab",
         "-theme-str", f"window {{ width: {width}px; }} listview {{ columns: {len(apps)}; }}",
         "-selected-row", "1" if len(apps) > 1 else "0",
         # Alt+Tab : Tab avance, relâcher Alt valide
         # bande horizontale : « élément suivant » (et non « ligne suivante ») ; boucle en fin de liste
         "-kb-move-char-back", "", "-kb-move-char-forward", "",  # libère ← →
         "-kb-element-next", "Alt+Tab,Tab,Right",
         "-kb-element-prev", "Alt+ISO_Left_Tab,ISO_Left_Tab,Left",
         "-kb-accept-entry", "Return,KP_Enter",
         "-kb-cancel", "Escape"],
        stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    watcher = threading.Thread(target=accept_on_alt_release, args=(proc,), daemon=True)
    watcher.start()
    out, _ = proc.communicate("\n".join(rows))
    choice = out.strip()
    if proc.returncode == 0 and choice.isdigit():
        con_id = apps[int(choice)][1]
        subprocess.run(["i3-msg", f"[con_id={con_id}]", "focus"], capture_output=True)


if __name__ == "__main__":
    if "--print" in sys.argv:  # aperçu texte, sans rofi
        for w in windows_mru(i3_tree()):
            print(w["id"], (w.get("window_properties") or {}).get("class"), "|", w.get("name"))
    else:
        main()
