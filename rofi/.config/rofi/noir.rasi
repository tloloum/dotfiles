/* Thème rofi noir, assorti à polybar (mêmes couleurs que [colors] de polybar/config.ini) */
* {
    bg:      #0b0b0bf2;
    bg-alt:  #1e1e1e;
    fg:      #bdbdbd;
    fg-dim:  #6e6e6e;
    accent:  #e6e6e6;
    urgent:  #c4605a;

    background-color: transparent;
    text-color:       @fg;
    font:             "CaskaydiaCove Nerd Font 10";
}

window {
    width:            480px;
    background-color: @bg;
    border:           1px;
    border-color:     @bg-alt;
    padding:          10px;
}

mainbox  { children: [ inputbar, message, listview ]; spacing: 8px; }

inputbar {
    children:         [ prompt, entry ];
    spacing:          10px;
    padding:          6px 10px;
    background-color: @bg-alt;
}
prompt   { text-color: @fg-dim; }
entry    { placeholder: ""; cursor: text; }
message  { padding: 4px 10px; }
textbox  { text-color: @fg; markup: true; }

listview {
    lines:        10;
    fixed-height: false;
    scrollbar:    false;
    spacing:      2px;
}

element               { padding: 5px 10px; cursor: pointer; }
element-text          { text-color: inherit; background-color: inherit; cursor: inherit; }
element-icon          { size: 1em; background-color: inherit; }
element normal.active { text-color: @accent; background-color: #161616; }
element selected.active { background-color: @bg-alt; text-color: @accent; }
element normal.urgent { text-color: @urgent; }
element selected      { background-color: @bg-alt; text-color: @accent; }
element selected.urgent { text-color: @urgent; }
